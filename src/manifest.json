{
  "manifest_version": 3,
  "name": "ClariText",
  "version": "0.1.0",
  "description": "Extensión Chromium con lectura por voz para personas con dislexia y TDAH",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "ClariText",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.bundle.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "tts-read": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Leer la selección actual"
    },
    "tts-stop": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Detener la lectura"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["modules/fonts/assets/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}
